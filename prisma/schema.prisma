generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id         Int        @id @default(autoincrement())
  name       String
  slug       String     @unique
  categoryId Int
  category   Category   @relation(fields: [categoryId], references: [id])
  price      Int
  stock      Int        @default(0)
  imageUrl   String?
  orderItems OrderItem[]

  @@index([categoryId])
  @@map("products")
}

model Order {
  id            Int         @id @default(autoincrement())
  invoiceNumber String      @unique
  subtotal      Int
  discount      Int         @default(0)
  tax           Int
  total         Int
  paymentMethod String
  status        String      @default("PAID")
  createdAt     DateTime    @default(now())
  items         OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int
  subtotal  Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Promo {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  type      String
  value     Int
  minOrder  Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?

  @@map("promos")
}
